---
// Layout.astro
import '@fontsource/vt323';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Etamine</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
  :root {
  /* Define your palette here */
  --primary-color: #ADAB85;
  --secondary-color: #51C2E9;
  --background-dark: #180811;
  --text-light: #D6D2BF;
  --accent-pixel: #00ff41; /* Great for that VT323 font! */
  }
  html,
  body {
    font-family: 'VT323', monospace;
    font-size: 24px;
    color: var(--primary-color);
    background-repeat: no-repeat;
    background-size: cover; /* Resizes image to cover the entire screen */
    background-position: center; /* Centers the image */
    background-attachment: fixed;
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .universe-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: black;
    overflow: hidden;
  }
  .stars-base {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: url(../images/Etamine_stars_16:9.jpg) center/cover no-repeat;
  }
  .foreground-image {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* This perfectly centers the div */
    z-index: 5; /* Higher than stars (1), lower than tracks (10) */
    pointer-events: none; /* Allows you to click tracks "through" the logo */
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .logo {

    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 47%;
    height: auto;
  }
  .track-item {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .track-container:hover .track-item {
  opacity: 0; /* Make them disappear (or use 0.2 to make them dim) */
  pointer-events: none; /* Optional: stops them from being clickable while hidden */
}
  .track-container:hover .track-item:hover {
    opacity: 1;
    pointer-events: auto; /* Keeps the hovered item interactive */
  }
  .label {
  position: relative;
  display: inline-block;
  /* align-items: center;
  justify-content: center;
  height: auto; */
}
    /* --- Base States (When NOT hovering) --- */
  .track-name {
    opacity: 1; /* Always visible */
    transition: opacity 0.3s ease;
    display: inline-block; /* Forces the browser to calculate width/height EXACTLY by the text size */
    line-height: 1; /* Eliminates extra vertical text-line spacing below the font baseline */
    padding: 4px 8px; /* Creates a tiny, predictable cushion just around the letters */
    margin: 0; /* Clears out any accidental browser paragraph margins pushing down */
    cursor: pointer;
  }
  /* --- Hover States --- */

  /* 1. Melt away the entire arrow and star setup instantly */
  .track-item:hover .arrow-container {
    opacity: 0;
    pointer-events: none; /* Prevents the invisible items from blocking mouse movements */
  }

  /* 2. Keep the text visible (and optional: make it pop over the video) */
  .track-item:hover .track-name {
    opacity: 1;
    color: #fff; /* Ensure it stands out against the background video */
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }
  .arrow-container {
  position:absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: max-content;
  opacity: 1; /* Both arrow and star are visible by default */
  transition: opacity 0.3s ease;
  /* transform-origin: top center; */
}
  .arrow {
  width: 1px;
  background-color: var(--primary-color);
  position: relative; /* CRITICAL: Anchors the absolute pseudo-element */
}

/* Optional: Adding a little triangle head to the arrow */
  .arrow::after {
  content: '';
  position: absolute;
  /* Push the triangle head completely outside the bottom of the line */
  /* bottom: -5px; */
  left: 50%;
  transform: translateX(-50%);
  bottom: var(--arrow-head-bottom, -5px);
  top: var(--arrow-head-top, auto);
  border-left: 5px solid transparent;
  border-right: 5px solid transparent;
  /* Points DOWN toward the star */
  border-top: var(--arrow-tip-down, 5px solid var(--primary-color));
  border-bottom: var(--arrow-tip-up, none);
}
  .arrow.arrow-up::after {
  bottom: auto;
  top: -5px; /* Pushes triangle out of the top of the line instead of the bottom */
  border-top: none;
  border-bottom: 5px solid var(--primary-color); /* Points UP toward the star */
}
  .arrow-target {
  /* CRITICAL: Creates a gap so the triangle head has room to sit without overlapping the image */
  margin-top: 8px;
  display: block;
}
  .track-item-hover {
    font-weight: bold;
    color: var(--text-light);
  }
  .track-video {
  position: absolute;
  inset: 0;
  width: 100vw;
  height: 100vh;
  object-fit: cover; /* Keeps video full screen without stretching */
  z-index: 2;        /* Sits above stars (1) but below tracks (10) */
  opacity: 0;
  transition: opacity 0.8s ease; /* Smooth fade in/out */
  pointer-events: none;
}

.track-video.active {
  opacity: 1;
}
</style>
