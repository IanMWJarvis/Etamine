---
import Layout from '../layouts/Layout.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- <link rel="stylesheet" href="src/styles/global.css"> -->
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} >
    <title>Étamine (Etamine) - Montreal electronic band</title>
    <meta name="description" content="Étamine (Etamine) is an electronic music collaboration between Canadian musicians Brock Geiger and Ian Jarvis. Based in Montréal, the duo produce a blend of synthwave, ambient techno and experimental electronic music.">
    <!-- <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://etaminesounds.com/" />
    <meta property="og:title" content="Étamine - Étamine (Etamine) is a Montreal-based band. London Extended Stay is their first full length record." />
    <meta property="og:description" content="Étamine (Etamine) is an electronic music collaboration between Canadian musicians Brock Geiger and Ian Jarvis. Based in Montréal, the duo produce a blend of synthwave, ambient techno and experimental electronic music." />
    <meta property="og:image" content="https://yourbandsite.com/og-image.jpg" />
    <meta property="og:site_name" content="Band Name" /> -->
    <audio id="global-player" preload="auto"></audio>
  </head>
  <body>
    <Layout>
      <main class="universe-container">
        <div class="stars-base"></div>
        <div class="foreground-image">
          <img src="../images/etamine_logo.png" alt="Etamine-logo" class="logo">
        </div>
        <div class="video-backgrounds">
          <video id="video-rotating-bodies" class="track-video" src="/video/rotating-bodies-video.mp4" muted loop playsinline></video>
          <video id="video-3-cycle-multi-programme" class="track-video" src="/video/3-cycle-video.mp4" muted loop playsinline></video>
          <video id="video-london-extended-stay" class="track-video" src="/video/london-extended-video.mp4" muted loop playsinline></video>
          <video id="video-helicopter-takeoff-at-night" class="track-video" src="/video/helicopter-video.mp4" loop playsinline></video>
          <video id="video-the-arrow-of-time" class="track-video" src="/video/arrow-video.mp4" muted loop playsinline></video>
          <video id="video-antiblue" class="track-video" src="/video/antiblue-video.mp4" loop playsinline></video>
          <video id="video-plastic-peaches" class="track-video" src="/video/plastic-peaches-video.mp4" muted loop playsinline></video>
          <video id="video-unnatural-causes" class="track-video" src="/video/unnatural-video.mp4" muted loop playsinline></video>
          <video id="video-zoe" class="track-video" src="/video/zoe-video.mp4" muted loop playsinline></video>
          <video id="video-virtual-traverse" class="track-video" src="/video/virtual-video.mp4" muted loop playsinline></video>
        </div>
        <nav class="star-map">
          <div class="track-container">
            <div class="track-item" data-track="rotating-bodies" data-audio="/audio/rotating-bodies.mp3">
              <div class="label">
                <span class="track-name">Rotating Bodies</span>
                <div class="arrow-container" style="top: 100%; left: 50%; transform: translateX(-50%) rotate(15deg); transform-origin: top center;">
                  <div class="arrow"></div>
                  <img src="images/small-star.png" alt="small-star" class="arrow-target">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="3-cycle-multi-programme" data-audio="/audio/3-cycle-multi-programme.mp3">
              <div class="label">
                <span class="track-name">3 Cycle Multi-Programme</span>
                <div class="arrow-container" style="bottom: 100%; left: 50%; transform: translateX(-50%) rotate(45deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/medium-star.png" alt="medium-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="london-extended-stay" data-audio="/audio/london-extended-stay.mp3">
              <div class="label">
                <span class="track-name">London Extended Stay</span>
                <div class="arrow-container" style="bottom: 100%; left: 0%; transform: translateX(-50%) rotate(310deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/medium-star.png" alt="medium-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="helicopter-takeoff-at-night" data-is-video="true">
              <div class="label">
                <span class="track-name">Helicopter Takeoff at Night</span>
                <div class="arrow-container" style="bottom: 10%; left: 50%; transform: translateX(-50%) rotate(190deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/small-star.png" alt="small-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                 </div>
              </div>
            </div>
            <div class="track-item" data-track="the-arrow-of-time" data-audio="/audio/the-arrow-of-time.mp3">
              <div class="label">
                <span class="track-name">The Arrow of Time</span>
                <div class="arrow-container" style="bottom: 30%; left: 100%; transform: translateX(-50%) rotate(105deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/small-star.png" alt="small-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="antiblue" data-is-video="true">
              <div class="label">
                <span class="track-name">AntiBlue</span>
                <div class="arrow-container" style="transform: rotate(35deg);">
                  <div class="arrow"></div>
                  <img src="images/large-star.png" alt="large-star" class="arrow-target">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="plastic-peaches" data-audio="/audio/plastic-peaches.mp3">
              <div class="label">
                <span class="track-name">Plastic Peaches</span>
                <div class="arrow-container" style="bottom: 100%; left: 50%; transform: translateX(-50%) rotate(325deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/medium-star.png" alt="medium-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="unnatural-causes" data-audio="/audio/unnatural-causes.mp3">
              <div class="label">
                <span class="track-name">Unnatural Causes</span>
                <div class="arrow-container" style="bottom: 10%; left: 50%; transform: translateX(-50%) rotate(165deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/medium-star.png" alt="medium-star" class="arrow-target" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="zoe" data-audio="/audio/zoe.mp3">
              <div class="label">
                <span class="track-name">Zoe</span>
                <div class="arrow-container" style="bottom: 100%; left: 60%; transform: translateX(-50%) rotate(25deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/small-star.png" alt="small-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
            <div class="track-item" data-track="virtual-traverse" data-audio="/audio/virtual-traverse.mp3">
              <div class="label">
                <span class="track-name">Virtual Traverse</span>
                <div class="arrow-container" style="bottom: 50%; left: 100%; transform: translateX(-50%) rotate(65deg); transform-origin: bottom center; flex-direction: column-reverse;">
                  <div class="arrow" style="--arrow-head-bottom: auto; --arrow-head-top: -5px; --arrow-tip-down: none; --arrow-tip-up: 5px solid var(--primary-color);"></div>
                  <img src="images/small-star.png" alt="small-star" class="arrow-target" style="margin-top: 0; margin-bottom: 8px;">
                </div>
              </div>
            </div>
          </div>
        </nav>
        <div class="mailing-list">

        </div>
        <div class="follow-container" >
            <a href="https://www.instagram.com/_etamine/" target="_blank">
              <i class="fa-brands fa-instagram" id="link"></i>
            </a>
            <a href="https://www.facebook.com/etaminesounds" target="_blank">
              <i class="fa-brands fa-facebook" id="link"></i>
            </a>
            <a href="https://etamine.bandcamp.com/" target="_blank">
              <i class="fa-brands fa-bandcamp" id="link"></i>
            </a>
            <a href="https://your-mailchimp-signup-url.com" target="_blank">
              <i class="fa-regular fa-envelope" id="link"></i>
            </a>
            <!-- <a href="https://tidal.com/artist/32674769/" target="_blank">
              <span id="link">TIDAL</span>
            </a> -->
        </div>
      </main>

    </Layout>
  </body>
</html>

<script>
  const trackItems = document.querySelectorAll('.track-item');
  const player = document.getElementById('global-player');
  const trackContainer = document.querySelector('.track-container');
  let activeTrackId = null;

  function stopTrack(item, targetVideo) {
    if (player) {
      player.pause();
      player.currentTime = 0;
    }
    item.classList.remove("track-item-hover");
    item.classList.remove("is-active");
    trackContainer.classList.remove("has-active-track");
    if (targetVideo) {
      targetVideo.classList.remove('active');
      targetVideo.pause();
      targetVideo.currentTime = 0;
    }
  }

  function stopActiveTrack() {
    if (!activeTrackId) return;
    const prevItem = document.querySelector(`[data-track="${activeTrackId}"]`);
    const prevVideo = document.getElementById(`video-${activeTrackId}`);
    if (prevItem) stopTrack(prevItem, prevVideo);
    activeTrackId = null;
  }

  trackItems.forEach(item => {
    const isFullVideo = item.getAttribute('data-is-video') === 'true';
    const trackId = item.getAttribute('data-track');
    const targetVideo = document.getElementById(`video-${trackId}`);
    const trackName = item.querySelector('.track-name');

    if (!trackName) return;

    function startTrack() {
      trackContainer.classList.add('has-active-track');
      item.classList.add('is-active');

      if (isFullVideo) {
        item.classList.add("track-item-hover");
        if (targetVideo) {
          targetVideo.classList.add('active');
          targetVideo.play().catch(e => console.log("Video play blocked"));
        }
      } else {
        const audioPath = item.getAttribute('data-audio');
        if (player && audioPath) {
          player.src = audioPath;
          player.play().catch(e => console.log("Audio play blocked"));
        }
        if (targetVideo) {
          targetVideo.classList.add('active');
          targetVideo.play().catch(e => console.log("Video background play blocked"));
        }
      }
      activeTrackId = trackId;
    }

    // Desktop hover behavior
    trackName.addEventListener('mouseenter', startTrack);
    trackName.addEventListener('mouseleave', () => {
      stopTrack(item, targetVideo);
      if (activeTrackId === trackId) activeTrackId = null;
    });

    // Touch: tap to start/toggle, stops propagation so the document-level
    // listener below doesn't immediately stop it again
    trackName.addEventListener('touchstart', (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (activeTrackId === trackId) {
        stopActiveTrack();
        return;
      }

      stopActiveTrack();
      startTrack();
    }, { passive: false });
  });

  // Click/tap anywhere else on the page stops whatever's playing
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.track-item')) {
      stopActiveTrack();
    }
  });

  document.addEventListener('touchstart', (e) => {
    if (!e.target.closest('.track-item')) {
      stopActiveTrack();
    }
  }, { passive: true });
</script>
